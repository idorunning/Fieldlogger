<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/forest">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <ImageView android:layout_width="112dp" android:layout_height="112dp"
            android:src="@drawable/ic_foreground" android:importantForAccessibility="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="@color/paper" android:textSize="34sp"
            android:gravity="center" android:fontFamily="sans-serif-medium" />
        <ProgressBar android:id="@+id/startup_progress" android:layout_width="40dp"
            android:layout_height="40dp" android:layout_marginTop="28dp" android:indeterminateTint="@color/lime" />
        <TextView android:id="@+id/startup_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/opening_journal" android:textColor="@color/paper"
            android:textSize="18sp" android:gravity="center" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:id="@+id/startup_actions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="24dp" android:visibility="gone">
            <Button android:id="@+id/retry_launch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/try_again"
                android:textAllCaps="false" android:textSize="18sp" android:backgroundTint="@color/lime"
                android:textColor="@color/forest" />
            <Button android:id="@+id/open_browser" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/open_browser"
                android:textAllCaps="false" android:textSize="18sp" android:backgroundTint="@color/paper"
                android:textColor="@color/forest" />
            <Button android:id="@+id/browser_settings" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/browser_settings"
                android:textAllCaps="false" android:textSize="18sp" android:backgroundTint="@color/paper"
                android:textColor="@color/forest" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
