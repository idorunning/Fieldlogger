# Server-only configuration. Values are intentionally blank.
OPENAI_API_KEY=
# Required for account API-key settings: a base64-encoded random 32-byte secret.
# Store only as a server runtime secret; never use a VITE_ or NEXT_PUBLIC_ name.
API_KEY_ENCRYPTION_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional specialist plant classifier:
PLANTNET_API_KEY=
# Optional separately hosted BioCLIP service:
BIOCLIP_URL=
BIOCLIP_TOKEN=
